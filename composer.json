{
    "name": "tyhp/io",
    "description": "Tyhp runtime io (PHP 8.2) — HTTP, processes, files, sockets, Redis, and databases on the tyhp/async event loop",
    "type": "library",
    "license": "Apache-2.0",
    "version": "802.0.3",
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "require": {"tyhpdef/php": "@dev"},
            "package": {
                "include": [
                    "./package.tyhpdef"
                ],
                "exclude": [],
                "overlay": [],
                "source": {
                    "tagless": false
                }
            }
        }
    },
    "require": {
        "php": ">=8.2",
        "tyhp/core": "802.0.* || 803.0.* || 804.0.* || 805.0.*",
        "tyhp/async": "802.0.* || 803.0.* || 804.0.* || 805.0.*"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    },
    "suggest": {
        "ext-curl": "Required by HttpClient",
        "ext-pgsql": "Required by PostgresConnection",
        "ext-mysqli": "Required by MySqlConnection",
        "ext-pdo": "Required by PdoConnection",
        "tyhp/parallel": "Runs PdoConnection, Dns, and Offload work in worker processes instead of blocking the event loop"
    },
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    },
    "autoload": {
        "psr-4": {
            "Tyhp\\": "src/Tyhp/"
        }
    }
}
